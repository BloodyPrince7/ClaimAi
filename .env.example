# Sarvam AI API Subscription Key
SARVAM_API_KEY=sk_your_sarvam_api_key_here

# When true, ClaimMate runs with robust deterministic offline fixtures & zero network risk
DEMO_MODE=true

# Database and Storage Paths
DATABASE_URL=sqlite:///./claimmate.db
STORAGE_DIR=./storage
CACHE_DIR=./.sarvam_cache
DEFAULT_LANG=hi-IN

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
